rules_version = '2';

// EstateFlow Cloud Storage rules. Files are private by default. Uploads go through the server,
// which validates type, size and image dimensions before writing with the Admin SDK. Reads are
// served by the authorised `/api/files` route; direct browser reads are additionally limited
// to active members of the owning estate with a role that may see that area.
service firebase.storage {
  match /b/{bucket}/o {

    function membership(estateId) {
      return firestore.get(/databases/(default)/documents/estateMembers/$(request.auth.uid + '_' + estateId));
    }

    // A missing membership document makes `.data` fail, which denies the request.
    function memberWithRole(estateId, roles) {
      return request.auth != null
        && membership(estateId).data.status == 'active'
        && membership(estateId).data.role in roles;
    }

    match /estates/{estateId}/ledger/{entryId}/{fileName} {
      allow read: if memberWithRole(estateId, ['manager', 'exco']);
      allow write: if false;
    }

    match /estates/{estateId}/tickets/{ticketId}/{fileName} {
      allow read: if memberWithRole(estateId, ['manager', 'exco']);
      allow write: if false;
    }

    match /estates/{estateId}/passes/{passId}/{fileName} {
      allow read: if memberWithRole(estateId, ['manager', 'guard']);
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
