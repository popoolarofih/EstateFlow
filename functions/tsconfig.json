{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": { "@/*": ["../src/*"], "server-only": ["./src/empty.ts"] },
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
