{
  "name": "estateflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "firebase emulators:exec --only auth,firestore,storage --project demo-estateflow \"vitest run --project integration\"",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-estateflow \"vitest run --project rules\"",
    "test:e2e": "playwright test --trace off",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:rules && npm run test:integration",
    "emulators": "firebase emulators:start --project demo-estateflow --import=.emulator-data --export-on-exit=.emulator-data",
    "emulators:fresh": "firebase emulators:start --project demo-estateflow",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "grant-platform-admin": "tsx --env-file=.env.local scripts/grant-platform-admin.ts",
    "functions:build": "npm --prefix functions run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@phosphor-icons/react": "^2.1.10",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.1",
    "geist": "^1.9.2",
    "next": "16.4.6",
    "papaparse": "^5.7.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "^15.36.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
