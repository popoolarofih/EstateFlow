# EstateFlow environment variables (example names only; never commit real values).
# Copy to .env.local for local development.

# ---------------------------------------------------------------------------
# Firebase web app (public, safe to ship to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-estateflow.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-estateflow
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-estateflow.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Point the browser SDK at the Emulator Suite. Must be "false" in staging/production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Optional: Firebase App Check with reCAPTCHA Enterprise (leave empty to disable on the client).
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Analytics on public pages only. Vercel Web Analytics (cookieless) turns on automatically on
# Vercel; set "true" to load it elsewhere. GA4 sets cookies, so it loads only after consent and
# its cookie banner appears only when a measurement id is set.
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Web push (FCM) VAPID public key. Leave empty to disable push registration.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---------------------------------------------------------------------------
# Server only. Prefer Application Default Credentials in deployed environments;
# set FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY only for local non-emulator use.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=demo-estateflow
FIREBASE_STORAGE_BUCKET=demo-estateflow.appspot.com
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes on a single line: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Emulator hosts for the Admin SDK (local development and tests only).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Reject API requests without a valid App Check token when "true".
APP_CHECK_ENFORCE=false

# Paystack (use sk_test_ keys outside production). The webhook signature is an
# HMAC SHA512 of the raw body keyed with your secret key; PAYSTACK_WEBHOOK_SECRET
# defaults to PAYSTACK_SECRET_KEY when left empty.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# 32+ random bytes, e.g. `openssl rand -base64 48`. Rotating it invalidates active pass codes.
PASS_CODE_HMAC_SECRET=dev-only-change-me-dev-only-change-me-0000

APP_BASE_URL=http://localhost:3000

# Optional: incoming webhook (Slack, Discord, PagerDuty Events...) that receives a short alert
# for every server or browser error. Errors are always written to the structured logs.
ERROR_ALERT_WEBHOOK_URL=
